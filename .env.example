# OPTIONAL. Everything here can be set in the app (Settings tab) instead — that's the easy way.
# Anything set here (or as an environment variable) overrides the app and shows as locked there.
# To use it: copy to .env, then uncomment and fill in only what you want to pin.

# --- Plex (required) -----------------------------------------------------------
# The server OWNER's token: watch history and deletes need it.
# How to find it: https://support.plex.tv/articles/204059436
# PLEX_URL=http://192.0.2.10:32400
# PLEX_TOKEN=

# --- Tautulli (optional, recommended) ------------------------------------------
# Adds partial plays, watch time and per-user detail. Without it, Plex's own
# history is used (completed views only).
# TAUTULLI_URL=
# TAUTULLI_API_KEY=

# --- Radarr / Sonarr (optional) ------------------------------------------------
# Needed to unmonitor what you delete (so it isn't re-downloaded) and for downgrades.
# Leave blank to discover them from Overseerr/Jellyseerr below.
# RADARR_URL=
# RADARR_API_KEY=
# SONARR_URL=
# SONARR_API_KEY=

# --- Overseerr / Jellyseerr (optional) -----------------------------------------
# Adds "who requested it". OVERSEERR_URL / OVERSEERR_API_KEY also work.
# SEERR_URL=
# SEERR_API_KEY=

# --- Free space (optional, pick one) -------------------------------------------
# Unraid 7 API key (Settings > Management Access > API Keys), read access to the array:
# UNRAID_URL=
# UNRAID_API_KEY=
# ...or any path(s) inside the container that live on your media filesystem(s):
# CAPACITY_PATHS=

# --- Disk walk (optional) ------------------------------------------------------
# "path as Plex sees it=path inside this container", comma separated. Mount the
# media read-only (see docker-compose.yml). Finds ISOs, rips and leftovers Plex
# doesn't index.
# WALK_PATHS=
# How paths are shown/copied in the UI, e.g. /data=/mnt/user/media
# DISPLAY_PATHS=

# --- Safety --------------------------------------------------------------------
# 1 = no deletes and no downgrades (browsing, lists and pins still work)
# RECLAIM_READ_ONLY=0
# Set both to require a login (HTTP basic auth). Put a TLS proxy in front if exposed.
# RECLAIM_USER=
# RECLAIM_PASSWORD=

# --- Schedule ------------------------------------------------------------------
# RECLAIM_REFRESH_HOUR=4
# TZ=UTC
